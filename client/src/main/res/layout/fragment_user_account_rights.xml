<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card: Master Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_settings_card">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chk_right_all"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card 1: Voice & Media -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_voice_media"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:textAllCaps="true"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_voice"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_video"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_desktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_desktop"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_desktop_access"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_desktop_access"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_media_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_media_audio"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_media_video"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_media_video"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_record_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_record_voice"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Card 2: Messages & Files -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_messages_files"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:textAllCaps="true"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_text_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_text_user"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_text_chan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_text_chan"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_text_broadcast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_text_broadcast"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_upload_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_upload_files"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_download_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_download_files"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Card 3: Channels & Administration -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_channels_admin"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:textAllCaps="true"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_create_chan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_create_chan"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_modify_chan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_modify_chan"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_operator_enable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_operator_enable"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_kick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_kick"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_ban"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_ban"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_move_users"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_move_users"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Card 4: System Rights -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_system_rights"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:textAllCaps="true"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_view_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_view_all"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_view_hidden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_view_hidden"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_multi_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_multi_login"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_change_nickname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_change_nickname"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/chk_right_update_server_props"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:text="@string/chk_right_update_server_props"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
