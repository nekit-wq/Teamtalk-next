<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/windowBackground">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/server_prop_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/windowBackground"
        app:tabMode="scrollable"
        app:tabGravity="fill"
        app:tabTextColor="@color/textSecondary"
        app:tabSelectedTextColor="@color/settingsAccent"
        app:tabIndicatorColor="@color/settingsAccent"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/settingsDivider" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/server_prop_viewpager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/card_save_server_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/windowBackground">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/settingsDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/btn_save_server_props"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_action_btn"
                android:text="@string/action_save"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
