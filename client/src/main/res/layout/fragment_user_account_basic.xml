<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card: Credentials -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_basic_info"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/settingsSectionHeader"
                android:textAllCaps="true"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_username"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edit_account_username"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_settings_input"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="15sp"
                android:inputType="text"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_password"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edit_account_password"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_settings_input"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="15sp"
                android:inputType="textPassword" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/hint_password_edit"
                android:textSize="12sp"
                android:textColor="@color/textSecondary" />
        </LinearLayout>

        <!-- Card: Account Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_user_type"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/settingsSectionHeader"
                android:textAllCaps="true"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/edit_account_type_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_type_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/radio_type_default"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radio_type_admin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/radio_type_admin"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/radio_type_none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/radio_type_none"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/note_admin_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:background="@color/settingsAccentLight"
                android:textColor="@color/settingsAccent"
                android:textSize="12sp"
                android:text="@string/note_admin_full_rights"
                android:visibility="gone" />

            <TextView
                android:id="@+id/note_disabled_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:background="@color/settingsWarningBg"
                android:textColor="@color/settingsWarningText"
                android:textSize="12sp"
                android:text="@string/note_disabled_user"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Card: Initial Channel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_init_channel"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/settingsSectionHeader"
                android:textAllCaps="true"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hint_init_channel"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/edit_account_init_chan"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_settings_input"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textSecondary"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none" />

                <ImageButton
                    android:id="@+id/btn_clear_init_chan"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_clear"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_select_init_chan"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_action_btn"
                android:text="@string/btn_select_channel"
                android:textColor="@color/settingsAccent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Card: Note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_settings_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_note"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/settingsSectionHeader"
                android:textAllCaps="true"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/edit_account_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:padding="12dp"
                android:gravity="top|start"
                android:background="@drawable/bg_settings_input"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="14sp"
                android:inputType="textMultiLine" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
