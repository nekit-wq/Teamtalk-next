<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_settings_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_logging"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выберите события, которые сервер будет фиксировать в журнале:"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chk_log_user_login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/label_log_user_login"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chk_log_user_kick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/label_log_user_kick"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chk_log_channel_create"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/label_log_channel"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chk_log_server_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/label_log_server_update"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chk_log_file_transfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/label_log_file_transfer"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
