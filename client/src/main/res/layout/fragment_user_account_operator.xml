<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_settings_card">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_channel_operator"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:textAllCaps="true"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Учетная запись автоматически получает статус оператора в следующих каналах (удерживайте канал для удаления):"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="12dp" />

        <ListView
            android:id="@+id/list_op_channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="?attr/colorOutlineVariant"
            android:dividerHeight="0.5dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_add_op_channel"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_secondary_action_btn"
        app:backgroundTint="@null"
        android:text="@string/btn_add_op_channel"
        android:textColor="?attr/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false" />
</LinearLayout>
