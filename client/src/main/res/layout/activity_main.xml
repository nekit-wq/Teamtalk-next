<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <com.google.android.material.tabs.TabLayout android:textColor="@color/tabLayoutTextColor" android:id="@+id/tab_layout" android:background="@color/tabLayoutBackground" android:paddingTop="4dp" android:paddingBottom="4dp" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <!-- Docked Mini-Panels (Telegram-style Audio Bar) -->
    <LinearLayout
        android:id="@+id/docked_panels_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Recording Bar -->
        <LinearLayout
            android:id="@+id/panel_recording_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bg_docked_recording_bar"
            android:visibility="gone">

            <ImageView
                android:id="@+id/rec_indicator_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_rec_dot"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rec_bar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/docked_recording_title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/rec_bar_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_rec_bar_pause"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="?android:selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_pause"
                android:contentDescription="@string/action_pause" />

            <ImageButton
                android:id="@+id/btn_rec_bar_stop"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="?android:selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/action_stop" />
        </LinearLayout>

        <!-- Media Streaming Bar -->
        <RelativeLayout
            android:id="@+id/panel_streaming_bar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_docked_streaming_bar"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/stream_bar_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_media_play"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stream_bar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/docked_streaming_title"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/stream_bar_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00 / 00:00"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_stream_bar_pause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_pause"
                    android:contentDescription="@string/action_pause" />

                <ImageButton
                    android:id="@+id/btn_stream_bar_stop"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="@string/action_stop" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/stream_bar_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:layout_alignParentBottom="true"
                android:max="1000"
                android:progress="0" />
        </RelativeLayout>
    </LinearLayout>
    <androidx.viewpager.widget.ViewPager android:id="@+id/pager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.0" />
    <View android:background="@color/dividerColor" android:layout_width="match_parent" android:layout_height="1dp" />
    <ProgressBar android:id="@+id/mic_activity_bar" android:visibility="gone" android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:progress="0" style="?android:progressBarStyleHorizontal" />
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@color/surfaceColor" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/network_stats_container"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:padding="2dp"
            android:background="?android:selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
            <TextView android:textSize="13sp" android:textStyle="bold" android:id="@+id/connectionstat_textview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:importantForAccessibility="yes" />
            <TextView android:textSize="13sp" android:id="@+id/pingstat_textview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:importantForAccessibility="yes" />
            <TextView android:textSize="13sp" android:id="@+id/totalstat_textview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:importantForAccessibility="yes" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0">
            <TextView android:textSize="13sp" android:gravity="center" android:id="@+id/vollevel_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
            <SeekBar android:id="@+id/master_volSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:contentDescription="@string/mastervolume" />
            <ImageButton android:layout_gravity="center" android:id="@+id/speakerBtn" android:background="?android:selectableItemBackgroundBorderless" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/speaker_blue" android:contentDescription="@string/speaker_mute" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0">
            <TextView android:textSize="13sp" android:gravity="center" android:id="@+id/miclevel_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" />
            <SeekBar android:id="@+id/mic_gainSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:contentDescription="@string/micgain" />
            <ImageButton android:layout_gravity="center" android:id="@+id/voxSwitch" android:background="?android:selectableItemBackgroundBorderless" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/mic_green" android:contentDescription="@string/voice_activation_on" />
        </LinearLayout>
        <Button android:textSize="14sp" android:textStyle="bold" android:textColor="#ffffffff" android:id="@+id/transmit_voice" android:background="@android:color/holo_red_light" android:layout_width="72dp" android:layout_height="72dp" android:text="@string/button_tx" android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>