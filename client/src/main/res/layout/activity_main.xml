<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top Material You Tab Navigation (Classic Layout) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorOnSurfaceVariant"
        app:tabIconTint="@color/selector_nav_item"
        app:tabRippleColor="?attr/colorControlHighlight"
        app:tabTextAppearance="@style/TabTextAppearance" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- Docked Mini-Panels (Telegram-style Audio Bar) -->
    <LinearLayout
        android:id="@+id/docked_panels_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Recording Bar -->
        <LinearLayout
            android:id="@+id/panel_recording_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:background="@drawable/bg_docked_recording_bar"
            android:visibility="gone">

            <ImageView
                android:id="@+id/rec_indicator_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_rec_dot"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/rec_bar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/docked_recording_title"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/rec_bar_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="11sp"
                    android:textColor="?android:attr/textColorSecondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_rec_bar_pause"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="?android:selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_pause"
                android:contentDescription="@string/action_pause" />

            <ImageButton
                android:id="@+id/btn_rec_bar_stop"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:background="?android:selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/action_stop" />
        </LinearLayout>

        <!-- Media Streaming Bar -->
        <RelativeLayout
            android:id="@+id/panel_streaming_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_docked_streaming_bar"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/stream_bar_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_play"
                    app:tint="?attr/colorPrimary"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stream_bar_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/docked_streaming_title"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/stream_bar_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00 / 00:00"
                        android:textSize="11sp"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_stream_bar_pause"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pause"
                    app:tint="?android:attr/textColorPrimary"
                    android:contentDescription="@string/action_pause" />

                <ImageButton
                    android:id="@+id/btn_stream_bar_stop"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="?android:selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:contentDescription="@string/action_stop" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/stream_bar_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2.5dp"
                android:layout_alignParentBottom="true"
                android:max="1000"
                android:progress="0" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Main ViewPager Content -->
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.0" />

    <ProgressBar
        android:id="@+id/mic_activity_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="?attr/colorPrimary"
        android:visibility="gone" />

    <!-- Compact Material You Voice Control Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/voice_control_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorSurfaceContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <!-- Compact Network stats badge -->
            <LinearLayout
                android:id="@+id/network_stats_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="?android:selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:id="@+id/connectionstat_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    android:text=""
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pingstat_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    android:text=""
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/totalstat_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="yes"
                    android:text=""
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Sliders Container: Row 1 = Speaker + Vol, Row 2 = Mic + Gain -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:orientation="vertical">

                <!-- Row 1: Speaker + Master Volume -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/speakerBtn"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_tonal_icon_button"
                        android:contentDescription="@string/speaker_mute"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_m3_volume_up"
                        app:tint="?attr/colorPrimary" />

                    <SeekBar
                        android:id="@+id/master_volSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:contentDescription="@string/mastervolume"
                        android:max="100"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progressDrawable="@drawable/seekbar_progress_m3"
                        android:thumb="@drawable/seekbar_thumb_m3" />

                    <TextView
                        android:id="@+id/vollevel_text"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:text=""
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2: Mic / VOX + Mic Gain -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/voxSwitch"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_tonal_icon_button"
                        android:contentDescription="@string/voice_activation_on"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_m3_mic_on"
                        app:tint="?attr/colorPrimary" />

                    <SeekBar
                        android:id="@+id/mic_gainSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:contentDescription="@string/micgain"
                        android:max="100"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:progressDrawable="@drawable/seekbar_progress_m3"
                        android:thumb="@drawable/seekbar_thumb_m3" />

                    <TextView
                        android:id="@+id/miclevel_text"
                        android:layout_width="32dp"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:text=""
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Compact Material 3 PTT Icon Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/transmit_voice"
                android:layout_width="54dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_ptt_button"
                app:backgroundTint="@null"
                app:icon="@drawable/ic_ptt_mic"
                app:iconTint="@android:color/white"
                app:iconSize="24dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:elevation="2dp"
                android:stateListAnimator="@null"
                android:text=""
                android:contentDescription="@string/button_tx" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
