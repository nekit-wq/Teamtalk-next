<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:animateLayoutChanges="true"
        android:padding="20dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chk_echo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chk_echo_enable"
            android:textAppearance="?android:textAppearanceMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/container_echo_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_echo_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/label_echo_level_default"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?android:textAppearanceSmall" />

            <SeekBar
                android:id="@+id/sb_echo_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="@string/label_echo_level_default"
                android:progressDrawable="@drawable/seekbar_progress_m3"
                android:thumb="@drawable/seekbar_thumb_m3"
                android:splitTrack="false"
                android:max="20"
                android:progress="7" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/chk_reverb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chk_reverb_enable"
            android:textAppearance="?android:textAppearanceMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/container_reverb_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_reverb_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/label_reverb_level_default"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?android:textAppearanceSmall" />

            <SeekBar
                android:id="@+id/sb_reverb_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/label_reverb_level_default"
                android:progressDrawable="@drawable/seekbar_progress_m3"
                android:thumb="@drawable/seekbar_thumb_m3"
                android:splitTrack="false"
                android:max="20"
                android:progress="10" />

            <TextView
                android:id="@+id/tv_reverb_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="32dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:text="@string/label_reverb_room_default"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textAppearance="?android:textAppearanceSmall" />

            <SeekBar
                android:id="@+id/sb_reverb_room"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/label_reverb_room_default"
                android:progressDrawable="@drawable/seekbar_progress_m3"
                android:thumb="@drawable/seekbar_thumb_m3"
                android:splitTrack="false"
                android:max="20"
                android:progress="12" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
