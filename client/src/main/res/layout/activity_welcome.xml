<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <androidx.viewpager.widget.ViewPager android:id="@+id/welcome_pager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.0" />
    <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@+id/welcome_dots_container" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton android:id="@+id/welcome_skip_btn" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/welcome_skip" android:textColor="?attr/colorPrimary" android:layout_weight="1.0" />
        <com.google.android.material.button.MaterialButton android:id="@+id/welcome_next_btn" style="@style/Widget.Material3.Button" app:backgroundTint="?attr/colorPrimary" android:textColor="?attr/colorOnPrimary" app:cornerRadius="20dp" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/welcome_next" android:layout_weight="1.0" />
    </LinearLayout>
</LinearLayout>