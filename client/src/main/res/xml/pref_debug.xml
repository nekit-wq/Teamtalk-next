<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/pref_debug_category_actions">
        <Preference
            android:key="pref_debug_copy_all"
            android:title="@string/pref_debug_copy_all"
            android:summary="@string/pref_debug_copy_all_summary" />
        <Preference
            android:key="pref_debug_share_all"
            android:title="@string/pref_debug_share_all"
            android:summary="@string/pref_debug_share_all_summary" />
        <Preference
            android:key="pref_debug_view_all"
            android:title="@string/pref_debug_view_all"
