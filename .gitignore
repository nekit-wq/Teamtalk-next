# Android client build outputs & cache
client/.gradle/
client/.idea/
client/build/
client/debug/
client/release/
client/local.properties
client/*.iml
client/*.jks

# Allow client keystore, jars, and native libraries
!client/libs/*.jar
!client/gradle/wrapper/gradle-wrapper.jar
!client/src/main/jniLibs/**/*.so
!client/release.keystore

# Python server virtualenv and caches
server/**/.venv/
server/**/__pycache__/
server/**/*.py[cod]
server/**/.pytest_cache/
.venv/
__pycache__/
*.py[cod]

# General IDE & OS files
.DS_Store
*.swp
*.bak
Thumbs.db
