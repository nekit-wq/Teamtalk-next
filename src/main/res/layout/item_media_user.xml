<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="horizontal" android:background="?android:selectableItemBackground" android:padding="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:textSize="15sp" android:id="@+id/media_nickname_textview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no_nickname" android:layout_centerVertical="true" android:paddingStart="8dp" android:layout_alignParentStart="true" />
