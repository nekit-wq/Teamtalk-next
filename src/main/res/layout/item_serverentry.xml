<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="?android:selectableItemBackground" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:id="@+id/servericon" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/teamtalk_yellow" android:scaleType="centerInside" android:contentDescription="@string/text_localserver" android:layout_marginEnd="12dp" />
    <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0">
        <TextView android:textSize="16sp" android:textStyle="bold" android:ellipsize="end" android:id="@+id/server_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:singleLine="true" />
        <TextView android:textSize="13sp" android:textColor="@color/textSecondary" android:ellipsize="end" android:id="@+id/server_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:singleLine="true" />
    </LinearLayout>
    <TextView android:textSize="13sp" android:textStyle="bold" android:id="@+id/server_ping" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="4dp" />
</LinearLayout>