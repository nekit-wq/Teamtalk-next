<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PLAYBACK SECTION -->
        <TextView
            android:id="@+id/eq_playback_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/eq_playback_section"
            android:textSize="18sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/eq_enable_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/eq_enable"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/eq_preset_label"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/eq_preset_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/eq_bands_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/eq_bass_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/eq_bass_boost"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/eq_bass_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/eq_virtualizer_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/eq_virtualizer"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/eq_virtualizer_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- MICROPHONE DSP SECTION -->
        <TextView
            android:id="@+id/eq_mic_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/eq_mic_section"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- DSP Engine Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/eq_dsp_engine_label"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/eq_dsp_engine_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>

        <!-- Noise Suppression -->
        <CheckBox
            android:id="@+id/eq_mic_ns_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/eq_mic_ns"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/eq_mic_ns_webrtc_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/eq_mic_ns_level_label"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/eq_mic_ns_level_spinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/eq_mic_ns_speex_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/eq_mic_speex_ns_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/eq_mic_speex_ns_depth"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/eq_mic_speex_ns_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Echo Cancellation -->
        <CheckBox
            android:id="@+id/eq_mic_aec_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/eq_mic_aec"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/eq_mic_aec_speex_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/eq_mic_speex_aec_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/eq_mic_speex_aec_depth"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/eq_mic_speex_aec_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Automatic Gain Control (AGC) -->
        <CheckBox
            android:id="@+id/eq_mic_agc_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/eq_mic_agc"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/eq_mic_agc_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/eq_mic_agc_mode_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/eq_mic_agc_mode_label"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/eq_mic_agc_mode_spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/eq_mic_agc_fixed_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/eq_mic_agc_fixed_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/eq_mic_agc_fixed_gain"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/eq_mic_agc_fixed_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/eq_mic_agc_adaptive_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/eq_mic_agc_max_gain_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/eq_mic_agc_max_gain"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/eq_mic_agc_max_gain_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/eq_mic_agc_headroom_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/eq_mic_agc_headroom"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/eq_mic_agc_headroom_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pre-Amplifier -->
        <CheckBox
            android:id="@+id/eq_mic_preamp_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/eq_mic_preamp"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/eq_mic_preamp_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eq_mic_preamp_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/eq_mic_preamp_gain"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/eq_mic_preamp_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Hardware Device Effects -->
        <CheckBox
            android:id="@+id/eq_mic_hw_effects_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/eq_mic_hw_effects"
            android:textSize="16sp" />

        <!-- Microphone frequency equalizer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Микрофонный эквалайзер"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/eq_mic_bands_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical" />

        <!-- GENERAL MIC LEVEL & VOX -->
        <!-- Microphone Gain -->
        <TextView
            android:id="@+id/eq_mic_gain_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/eq_mic_gain"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/eq_mic_gain_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- VOX Activation Level -->
        <TextView
            android:id="@+id/eq_vox_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/eq_vox_level"
            android:textSize="16sp" />

        <SeekBar
            android:id="@+id/eq_vox_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Reset Button -->
        <Button
            android:id="@+id/eq_reset_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/eq_reset" />

    </LinearLayout>
</ScrollView>