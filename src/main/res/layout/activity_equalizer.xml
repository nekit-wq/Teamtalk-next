<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:padding="16dp" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:textSize="18sp" android:textStyle="bold" android:id="@+id/eq_playback_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/eq_playback_section" />
        <CheckBox android:textSize="16sp" android:id="@+id/eq_enable_checkbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/eq_enable" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/eq_preset_label" android:layout_marginEnd="8dp" />
            <Spinner android:id="@+id/eq_preset_spinner" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:id="@+id/eq_bands_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" />
        <TextView android:textSize="16sp" android:id="@+id/eq_bass_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/eq_bass_boost" />
        <SeekBar android:id="@+id/eq_bass_seekbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" />
        <TextView android:textSize="16sp" android:id="@+id/eq_virtualizer_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/eq_virtualizer" />
        <SeekBar android:id="@+id/eq_virtualizer_seekbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" />
        <TextView android:textSize="18sp" android:textStyle="bold" android:id="@+id/eq_mic_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/eq_mic_section" />
        <CheckBox android:textSize="16sp" android:id="@+id/eq_mic_ns_checkbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/eq_mic_ns" />
        <CheckBox android:textSize="16sp" android:id="@+id/eq_mic_aec_checkbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/eq_mic_aec" />
        <CheckBox android:textSize="16sp" android:id="@+id/eq_mic_agc_checkbox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/eq_mic_agc" />
        <TextView android:textSize="16sp" android:id="@+id/eq_mic_hpf_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/eq_mic_hpf" />
        <SeekBar android:id="@+id/eq_mic_hpf_seekbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" />
        <TextView android:textSize="16sp" android:id="@+id/eq_mic_gain_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/eq_mic_gain" />
        <SeekBar android:id="@+id/eq_mic_gain_seekbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" />
        <TextView android:textSize="16sp" android:id="@+id/eq_vox_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="@string/eq_vox_level" />
        <SeekBar android:id="@+id/eq_vox_seekbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" />
        <Button android:id="@+id/eq_reset_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:text="@string/eq_reset" />
    </LinearLayout>
</ScrollView>