<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:background="?colorPrimary"
        android:layout_width="match_parent"
        android:layout_height="?android:actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:background="?selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@android:color/white"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:id="@+id/picker_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/custom_picker_title"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

        <ImageButton
            android:id="@+id/btn_create_folder"
            android:background="?selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_input_add"
            android:tint="@android:color/white"
            android:contentDescription="@string/btn_create_folder_desc" />

        <ImageButton
            android:id="@+id/btn_sort"
            android:background="?selectableItemBackgroundBorderless"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@android:color/white"
            android:contentDescription="@string/btn_sort" />

        <Button
            android:id="@+id/btn_search_tt"
            android:textSize="11sp"
            android:textColor="?colorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_search_tt_files"
            android:contentDescription="@string/btn_search_tt_files_desc"
            android:backgroundTint="@android:color/white"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_current_path"
        android:textSize="13sp"
        android:textColor="@color/textSecondary"
        android:ellipsize="start"
        android:background="#1f000000"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true" />

    <EditText
        android:id="@+id/search_edit_text"
        android:textSize="14sp"
        android:background="#0a000000"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_filter_results"
        android:drawablePadding="8dp"
        android:inputType="text"
        android:drawableStart="@android:drawable/ic_menu_search" />

    <TextView
        android:id="@+id/txt_search_status"
        android:textSize="13sp"
        android:textColor="@color/textSecondary"
        android:background="#1f000000"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ProgressBar
        android:id="@+id/search_progress"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        style="?android:progressBarStyleHorizontal" />

    <ListView
        android:id="@+id/file_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="@color/dividerColor"
        android:dividerHeight="1dp"
        android:layout_weight="1.0" />

    <Button
        android:id="@+id/btn_select_folder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_select_this_folder" />
</LinearLayout>